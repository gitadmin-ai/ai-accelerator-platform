# Rendered at container start by the nginx image's envsubst hook
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only BACKEND_URL
# is substituted; nginx's own $variables are left alone.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The SPA calls the backend through this same origin (VITE_API_BASE=/api),
    # so the image is not tied to any host/IP and needs no CORS.
    # The trailing slashes strip the /api prefix before proxying.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE job events (/jobs/{id}/events) and artifact downloads must
        # stream, not be buffered; dataset uploads can be large.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 0;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
